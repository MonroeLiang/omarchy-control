#pragma once

// Written by qmake from VERSION in omarchy-control.pro. A header rather than a compiler
// define, so changing the version rebuilds what uses it.
// qmake drops quotes when it substitutes, so the preprocessor makes the string.
#define OMARCHY_CONTROL_STRING_(x) #x
#define OMARCHY_CONTROL_STRING(x) OMARCHY_CONTROL_STRING_(x)
#define APP_VERSION OMARCHY_CONTROL_STRING($${VERSION})
